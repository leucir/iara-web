        <mxCell id="hQ6ItJcDlCljn19Vy9uE-4" value="&lt;h1&gt;Data&lt;/h1&gt;&lt;p&gt;The entities that the end-consumers will interact with. Essential component for all services provided by Wallfy.&lt;/p&gt;" style="text;html=1;strokeColor=none;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
